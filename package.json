{
  "name": "ocr.siliconwat.dev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read a page of the Buddhist Institute Tipiṭaka (Pāli and Khmer, in Khmer script) in your own browser.",
  "scripts": {
    "predev": "node scripts/vendor.mjs && node scripts/check-models.mjs --dev",
    "dev": "vite",
    "build": "node scripts/vendor.mjs && node scripts/check-models.mjs && tsc --noEmit && vite build",
    "build:dev": "node scripts/vendor.mjs && node scripts/check-models.mjs --dev && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test test/*.test.ts",
    "parity": "tsx scripts/parity.ts",
    "review-km": "tsx scripts/review-km.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/noto-sans-khmer": "5.3.0",
    "@fontsource/noto-serif-khmer": "5.3.0",
    "idb-keyval": "6.3.0",
    "lit": "3.3.3",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
